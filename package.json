{
  "name": "tool-ui-vue",
  "version": "0.1.0",
  "description": "Vue 3 component library for tool call widgets (copy-paste style)",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "pnpm -r --filter='./packages/*' run build",
    "typecheck": "pnpm -r --filter='./packages/*' run typecheck",
    "build:all": "pnpm -r build",
    "typecheck:all": "pnpm -r typecheck",
    "dev": "vite dev playground --config playground/vite.config.ts --port 5740 --host",
    "dev:lib": "vite",
    "story:dev": "histoire dev --host --port 5741",
    "story:build": "histoire build",
    "story:preview": "histoire preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --fix",
    "check": "pnpm lint && pnpm typecheck:all"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@lionad/components": "workspace:*",
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "@vueuse/components": "^14.2.1",
    "@vueuse/core": "^14.2.1",
    "@vueuse/integrations": "^14.2.1",
    "@vueuse/motion": "^3.0.3",
    "@vueuse/nuxt": "^14.2.1",
    "@vueuse/router": "^14.2.1",
    "ansi-to-html": "^0.7.2",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "diff": "^8.0.4",
    "leaflet": "^1.9.4",
    "lucide-vue-next": "^1.0.0",
    "shiki": "^4.0.2",
    "supercluster": "^8.0.1",
    "tailwind-merge": "^3.5.0",
    "vue-chartjs": "^5.3.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@histoire/plugin-vue": "1.0.0-beta.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/diff": "^8.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.5.2",
    "@types/supercluster": "^7.1.3",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.2",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.2.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-tailwindcss": "4.0.0-beta.0",
    "eslint-plugin-vue": "^10.8.0",
    "histoire": "1.0.0-beta.1",
    "jsdom": "^29.0.1",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.0.3",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.2",
    "vue": "^3.5.32",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.6"
  }
}
