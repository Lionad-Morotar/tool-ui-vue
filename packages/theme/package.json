{
  "name": "@lionad/vtu-theme",
  "version": "0.1.0",
  "description": "Design tokens and CSS variables for tool-ui-vue",
  "license": "MIT",
  "type": "module",
  "files": ["dist"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build && cp src/tokens.css dist/tokens.css",
    "typecheck": "vue-tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^8.0.3",
    "vue-tsc": "^2.2.0"
  }
}
