{
  "name": "@lionad/core",
  "version": "0.1.0",
  "description": "Core utilities and base components for tool-ui-vue",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
