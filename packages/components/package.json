{
  "name": "@lionad/vtu-components",
  "version": "0.3.16-alpha.3",
  "description": "Tool call UI components for tool-ui-vue",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vue-tsc --noEmit && vite build && cp ../theme/dist/tokens.css dist/tokens.css && node post-build.mjs",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.4.0",
    "dompurify": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "dompurify": {
      "optional": true
    }
  },
  "dependencies": {
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "class-variance-authority": "^0.7.1",
    "@vueuse/core": "^14.2.1",
    "@vueuse/components": "^14.2.1",
    "@vueuse/integrations": "^14.2.1",
    "@vueuse/motion": "^3.0.3",
    "@vueuse/nuxt": "^14.2.1",
    "@vueuse/router": "^14.2.1",
    "ansi-to-html": "^0.7.2",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "diff": "^8.0.4",
    "leaflet": "^1.9.4",
    "lucide-vue-next": "^1.0.0",
    "marked": "^15.0.0",
    "shiki": "^4.0.2",
    "supercluster": "^8.0.1",
    "tailwind-merge": "^3.5.0",
    "vue-chartjs": "^5.3.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@lionad/vtu-theme": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.5",
    "@types/diff": "^8.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/supercluster": "^7.1.3",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.32",
    "vue-tsc": "^3.2.6"
  }
}
