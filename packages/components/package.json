{
  "name": "@lionad/components",
  "version": "0.1.0",
  "description": "Tool call UI components for tool-ui-vue",
  "license": "MIT",
  "type": "module",
  "files": ["dist"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./components/*": "./dist/components/*"
  },
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@lionad/core": "workspace:*",
    "@lionad/theme": "workspace:*",
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "@vueuse/core": "^14.2.1",
    "@vueuse/components": "^14.2.1",
    "@vueuse/integrations": "^14.2.1",
    "@vueuse/motion": "^3.0.3",
    "@vueuse/nuxt": "^14.2.1",
    "@vueuse/router": "^14.2.1",
    "ansi-to-html": "^0.7.2",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "diff": "^8.0.4",
    "leaflet": "^1.9.4",
    "lucide-vue-next": "^0.468.0",
    "shiki": "^1.24.0",
    "supercluster": "^8.0.1",
    "tailwind-merge": "^2.6.1",
    "vue-chartjs": "^5.3.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "@types/diff": "^8.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/supercluster": "^7.1.3",
    "typescript": "^5.9.0",
    "vite": "^8.0.3",
    "vite-plugin-dts": "^4.5.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.0"
  }
}
