{
  "name": "@lionad/vtu-server",
  "version": "0.3.9",
  "description": "MCP server for tool-ui-vue component library",
  "license": "MIT",
  "type": "module",
  "main": "./dist/mcp/index.js",
  "types": "./dist/mcp/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "vtu-mcp-server": "./dist/mcp/index.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-sources.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch mcp/index.ts",
    "test:smoke": "vitest run mcp/__test__"
  },
  "dependencies": {
    "@lionad/vtu-components": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
